{
  "name": "swakosh",
  "version": "1.0.0",
  "description": "SwaKosh (स्वकोश) — Smart Lists, Rich Notes, Visiting Card OCR & Post-Quantum KeePass (.kdbx) Vault",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "python3 -m http.server 5173",
    "start": "python3 -m http.server 5173",
    "build:www": "mkdir -p www && cp -r index.html manifest.json sw.js assets styles src MasterVault_Standalone.html www/",
    "mobile:init": "npm run build:www && npx @capacitor/cli add android && npx @capacitor/cli add ios",
    "mobile:sync": "npm run build:www && npx @capacitor/cli sync",
    "mobile:open:android": "npx @capacitor/cli open android",
    "mobile:open:ios": "npx @capacitor/cli open ios"
  },
  "dependencies": {
    "@capacitor/android": "^6.0.0",
    "@capacitor/app": "^6.0.0",
    "@capacitor/camera": "^6.0.0",
    "@capacitor/core": "^6.0.0",
    "@capacitor/filesystem": "^6.0.0",
    "@capacitor/ios": "^6.0.0",
    "@capacitor/share": "^6.0.0",
    "@capacitor/splash-screen": "^6.0.0",
    "@capacitor/status-bar": "^6.0.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^6.0.0"
  },
  "keywords": [
    "swakosh",
    "post-quantum",
    "kdbx",
    "keepass",
    "capacitor",
    "pwa",
    "local-first",
    "zero-knowledge"
  ],
  "license": "MIT"
}
